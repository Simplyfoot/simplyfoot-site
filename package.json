{
    "name": "simplyfoot-site",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "type-check": "tsc --noEmit",
        "prettier:check": "prettier --check .",
        "prettier:fix": "prettier --write .",
        "check-all": "npm run type-check && npm run lint && npm run prettier:check",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.6.0",
        "@react-three/postprocessing": "^3.0.4",
        "next": "15.5.15",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-hook-form": "^7.72.1",
        "three": "^0.183.2",
        "zod": "^4.3.6",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/eslintrc": "^3",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "^0.183.1",
        "eslint": "^9",
        "eslint-config-next": "15.5.15",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "typescript": "^5"
    }
}
