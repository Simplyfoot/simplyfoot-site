{
    "name": "simplyfoot-site",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "type-check": "tsc --noEmit",
        "prettier:check": "prettier --check .",
        "prettier:fix": "prettier --write .",
        "check-all": "npm run type-check && npm run lint && npm run prettier:check",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@base-ui/react": "^1.4.0",
        "@gsap/react": "^2.1.2",
        "@hookform/resolvers": "^5.2.2",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.6.0",
        "@react-three/postprocessing": "^3.0.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.38.0",
        "gsap": "^3.15.0",
        "lenis": "^1.3.23",
        "lucide-react": "^1.8.0",
        "next": "15.5.15",
        "next-intl": "^4.9.1",
        "next-themes": "^0.4.6",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-hook-form": "^7.72.1",
        "shadcn": "^4.2.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "three": "^0.183.2",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.3.6",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/eslintrc": "^3",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "^0.183.1",
        "eslint": "^9",
        "eslint-config-next": "15.5.15",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwindcss": "^4",
        "typescript": "^5"
